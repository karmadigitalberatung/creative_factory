# Kopieren nach .env und Schlüssel dort eintragen. .env wird nie eingecheckt, diese Datei schon.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Seedream (ByteDance) als zweiter Bildgenerator, optional
SEEDREAM_API_KEY=
# SEEDREAM_MODEL=dola-seedream-5-0-pro-260628
# optional
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# SECRET_KEY=
# Buffer per OAuth (App Client unter publish.buffer.com/settings/api), optional.
# Ohne Client-ID verbindet man Buffer in der App mit einem persönlichen API-Schlüssel.
# Redirect-URI beim App Client eintragen: http://localhost:8040/connectors/buffer/callback
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# BUFFER_REDIRECT_URI=
