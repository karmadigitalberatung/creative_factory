# In /opt/kopfkino/deploy/Caddyfile ergänzen (gemeinsamer Caddy auf dem VPS)
heykajo.studio {
	encode zstd gzip
	request_body {
		max_size 300MB
	}
	reverse_proxy creative-factory-app:8040 {
		transport http {
			read_timeout 10m
		}
	}
}

# www läuft über den Cloudflare-Proxy: Let's Encrypt kommt dort nicht durch, darum ein eigenes Zertifikat von Caddy
# (reicht für den Cloudflare-SSL-Modus „Full“, nicht für „Full (strict)“). Besucher sehen das Zertifikat von Cloudflare.
www.heykajo.studio {
	tls internal
	redir https://heykajo.studio{uri} 308
}

# Alte Adresse: Claude-Verbindungen (/mcp) und Bildlinks in verschickten Newslettern (/o/...) laufen weiter, alles andere zieht um.
contenthub.karma.at {
	encode zstd gzip
	request_body {
		max_size 300MB
	}
	@weiter path /mcp /o/*
	handle @weiter {
		reverse_proxy creative-factory-app:8040 {
			transport http {
				read_timeout 10m
			}
		}
	}
	handle {
		redir https://heykajo.studio{uri} 308
	}
}
